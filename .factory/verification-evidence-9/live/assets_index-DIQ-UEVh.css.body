:root{--paper: #f5f0e4;--surface: #fffaf0;--ink: #171614;--muted: #625d54;--blue: #1647b7;--blue-contrast: #fff;--orange: #d85a2a;--line: #c9c0b0;--success: #176b4d;color:var(--ink);background:var(--paper);font:17px/1.55 Arial,Helvetica,sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 15% 10%,rgba(216,90,42,.07),transparent 24rem),var(--paper)}a{color:inherit;text-decoration-thickness:1.5px;text-underline-offset:3px}button,.link-button{font:inherit}.skip{position:fixed;z-index:10;top:-4rem;left:12px;background:var(--blue);color:var(--blue-contrast);padding:10px 14px}.skip:focus{top:12px}.site-header{max-width:1180px;margin:auto;min-height:76px;padding:16px 28px;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px dotted var(--muted)}.wordmark{text-decoration:none;font-weight:700;letter-spacing:-.02em}.wordmark span{color:var(--blue);letter-spacing:-4px;margin-right:7px}nav{display:flex;gap:20px;font-size:15px}nav a{min-height:44px;display:inline-grid;align-items:center}.hero{max-width:1180px;margin:auto;padding:62px 28px 46px;display:grid;grid-template-columns:minmax(0,1fr) minmax(330px,.92fr);gap:54px;align-items:center}.hero-copy{max-width:620px}.eyebrow{margin:0 0 10px;color:var(--blue);font-size:12px;line-height:1.2;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.hero h1,.demo-intro h1,.legal h1,.not-found h1{font:700 clamp(42px,6vw,76px) / .99 Georgia,Times,serif;letter-spacing:-.05em;margin:0;max-width:700px}.lede{font-size:20px;max-width:590px;margin:22px 0}.actions{display:flex;flex-wrap:wrap;gap:14px;align-items:center;margin:30px 0 22px}.actions span{font-size:14px;color:var(--muted)}.primary{min-height:46px;display:inline-flex;align-items:center;justify-content:center;background:var(--blue);color:var(--blue-contrast);border:2px solid var(--ink);border-radius:7px;padding:10px 16px;font-weight:800;box-shadow:3px 3px 0 var(--ink);cursor:pointer;text-decoration:none}.primary:hover{transform:translate(1px,1px);box-shadow:2px 2px 0 var(--ink)}.facts{margin:0;padding:0;display:flex;flex-wrap:wrap;gap:10px 22px;font-size:14px;list-style:none}.facts li:before{content:"●";color:var(--orange);padding-right:7px}.hero-art{margin:0;position:relative}.hero-art:after{content:"";position:absolute;inset:15px -10px -12px 12px;border:1px solid var(--ink);z-index:-1}.hero-art img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;border:1px solid var(--ink);filter:saturate(.9) contrast(1.04)}.preview-section{max-width:1180px;margin:auto;padding:60px 28px 72px;content-visibility:auto}.section-label{max-width:600px}.section-label h2,.how h2,.privacy-blurb h2,.install h2,.demo-capture h2{font:700 clamp(30px,4vw,48px) / 1.08 Georgia,Times,serif;letter-spacing:-.035em;margin:0 0 25px}.board{background:var(--surface);border:2px solid var(--ink);box-shadow:7px 7px 0 var(--blue);padding:24px}.board-heading{display:flex;justify-content:space-between;gap:15px;align-items:start;border-bottom:1px dotted var(--muted);padding-bottom:17px}.board h2{font:700 32px/1.1 Georgia,Times,serif;margin:0}.quiet-button{min-height:44px;padding:8px 12px;background:transparent;border:1px solid var(--ink);border-radius:5px;cursor:pointer;font-weight:700}.quiet-button:disabled{opacity:.5}.review-row{display:grid;grid-template-columns:1.25fr .75fr;gap:24px;padding:23px 0}.phrase-card{position:relative;border:1px solid var(--line);border-left:7px solid var(--blue);padding:17px 19px;background:#fffdf7}.phrase{font:700 26px/1.1 Georgia,serif;margin:0 0 8px}.phrase-card blockquote{font:18px/1.5 Georgia,serif;margin:0}.gloss{margin:15px 0 3px}.source{margin:0;color:var(--muted);font-size:13px}.external{white-space:nowrap}.review-action{align-self:center}.review-action>p:first-child{font-size:18px}.review-action details{padding:12px 0}.review-action summary{font-weight:700;cursor:pointer}.small{font-size:13px;color:var(--muted)}.saved-head{display:flex;justify-content:space-between;border-top:1px dotted var(--muted);padding-top:20px}.saved-head h3{margin:0;font-size:15px}.saved-head span{font-size:14px;color:var(--muted)}.saved-list{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:14px}.phrase-card.compact{padding:12px}.compact .phrase{font-size:20px}.compact blockquote{font-size:15px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.compact .gloss{font-size:14px;margin-top:9px}.empty{text-align:center;padding:40px}.how{padding:72px max(28px,calc((100% - 1124px)/2));background:var(--ink);color:#f8f2e7}.how .eyebrow{color:#ff9c71}.how h2{max-width:600px}.how ol{padding:0;margin:36px 0 0;display:grid;grid-template-columns:repeat(3,1fr);gap:24px;list-style:none;counter-reset:steps}.how li{counter-increment:steps;border-top:2px solid #f8f2e7;padding-top:14px}.how li:before{content:"0" counter(steps);color:#ff9c71;font-size:13px;font-weight:700}.how strong,.how span{display:block}.how strong{font:700 25px Georgia,serif;margin:10px 0}.how span{color:#dfd8ca}.privacy-blurb{max-width:1124px;margin:auto;padding:75px 0;display:grid;grid-template-columns:1.15fr .85fr;gap:60px}.privacy-blurb p{max-width:450px;margin-top:30px}.install{border-top:2px solid var(--ink);max-width:1124px;margin:auto;padding:45px 0 76px;display:flex;justify-content:space-between;gap:30px;align-items:end}.install p{max-width:640px}.install-steps{max-width:640px;margin:22px 0;padding-left:24px}.install-steps li+li{margin-top:8px}.install code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.9em}.install a:not(.link-button){min-height:44px;display:inline-flex;align-items:center}.demo-banner{position:sticky;top:0;z-index:3;display:flex;justify-content:center;align-items:center;gap:18px;min-height:48px;padding:7px 20px;background:var(--ink);color:#f8f2e7;font-size:14px}.demo-banner button{color:#fff;background:transparent;border:0;text-decoration:underline;cursor:pointer;min-height:36px}.demo-banner a{color:#fff}.demo-intro{max-width:1124px;margin:auto;padding:54px 0 26px}.demo-intro h1{font-size:clamp(38px,5vw,62px)}.demo-intro+.board{max-width:1124px;margin:22px auto 64px}.demo-capture{max-width:1124px;margin:auto;padding:55px 0}.legal,.not-found,.recovery{max-width:760px;margin:70px auto 110px}.legal h1,.not-found h1,.recovery h1{font-size:clamp(38px,5vw,62px);margin-bottom:30px}.legal p{font:19px/1.65 Georgia,serif}.not-found p{font-size:20px}.recovery>section>p{max-width:640px;font-size:19px}.recovery-actions,.dialog-actions{display:flex;flex-wrap:wrap;gap:14px;margin:28px 0}.danger-button{min-height:44px;padding:10px 16px;border:2px solid var(--ink);border-radius:7px;background:var(--orange);color:#171614;box-shadow:3px 3px 0 var(--ink);font:inherit;font-weight:800;cursor:pointer}.recovery-dialog{width:min(520px,calc(100% - 32px));border:2px solid var(--ink);border-radius:10px;padding:24px;color:var(--ink);background:var(--surface);box-shadow:8px 8px 0 var(--blue)}.recovery-dialog::backdrop{background:#1716149e}.recovery-dialog h2{font:700 30px/1.1 Georgia,Times,serif;margin:0}footer{border-top:1px dotted var(--muted);padding:30px max(28px,calc((100% - 1124px)/2));font-size:14px;color:var(--muted)}footer p{margin:4px 0}h1:focus{outline:0}a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid var(--orange);outline-offset:4px}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.primary:hover{transform:none}}@media(max-width:720px){:root{font-size:16px}.site-header{padding:13px 17px;align-items:flex-start;flex-direction:column;gap:4px}nav{width:100%;justify-content:space-between;gap:4px}.hero{padding:42px 18px 38px;grid-template-columns:1fr;gap:30px}.hero h1{font-size:47px}.preview-section{padding:44px 18px 56px}.board{padding:16px;box-shadow:5px 5px 0 var(--blue)}.board h2{font-size:27px}.review-row,.privacy-blurb{grid-template-columns:1fr;gap:18px}.saved-list{grid-template-columns:1fr}.how{padding:52px 18px}.how ol{grid-template-columns:1fr;gap:29px}.privacy-blurb{padding:55px 18px}.install{margin:0 18px;padding:40px 0 54px;display:block}.install .primary{margin-top:10px}.demo-banner{justify-content:space-between;gap:8px;padding:6px 12px;font-size:12px}.demo-banner span{max-width:150px}.demo-intro,.demo-intro+.board,.demo-capture{margin-left:18px;margin-right:18px}.demo-intro{padding-top:36px}.facts{display:block}.facts li{margin-top:8px}}h1:focus{outline:3px solid var(--orange);outline-offset:6px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(prefers-color-scheme:dark){:root{--paper: #171614;--surface: #25231f;--ink: #f8f2e7;--muted: #c9c0b0;--blue: #7da8ff;--blue-contrast: #171614;--orange: #ff9c71;--line: #625d54;--success: #6dd4a4}body{background:radial-gradient(circle at 15% 10%,rgba(255,156,113,.1),transparent 24rem),var(--paper)}.hero-art img{filter:saturate(.88) contrast(1.04) brightness(.9)}.phrase-card{background:#2d2a25}.primary{border-color:#f8f2e7;box-shadow:3px 3px #f8f2e7}.primary:hover{box-shadow:2px 2px #f8f2e7}.quiet-button{color:var(--ink);border-color:var(--ink)}.how{background:#25231f}.how li{border-color:#f8f2e7}.demo-banner{background:#25231f}}.how:focus{outline:3px solid #ff9c71;outline-offset:-8px}.demo-banner button,.demo-banner a{min-height:44px;display:inline-flex;align-items:center}.review-action summary{min-height:44px;display:flex;align-items:center}.wordmark,.source a,.legal a,footer a{min-height:44px;display:inline-flex;align-items:center}@media(max-width:720px){.legal,.not-found,.recovery{margin-left:18px;margin-right:18px}}
