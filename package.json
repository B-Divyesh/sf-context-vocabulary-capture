{
  "name": "context-vocabulary-capture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --host 0.0.0.0",
    "build": "npm run build:site",
    "build:site": "wxt build && vite build && npm run package:extension",
    "package:extension": "node scripts/package-extension.mjs",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts && playwright test",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test",
    "test:watch": "vitest --config vitest.config.ts",
    "preview:site": "node scripts/preview-static.mjs"
  },
  "dependencies": {
    "wxt": "0.21.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.2",
    "@types/chrome": "^0.0.289",
    "eslint": "^9.39.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.2"
  }
}
