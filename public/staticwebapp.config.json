{
  "responseOverrides": { "404": { "rewrite": "/404.html", "statusCode": 404 } },
  "globalHeaders": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" },
  "routes": [
    { "route": "/", "rewrite": "/index.html" },
    { "route": "/demo", "rewrite": "/index.html" },
    { "route": "/privacy", "rewrite": "/index.html" },
    { "route": "/terms", "rewrite": "/index.html" },
    { "route": "/assets/dithered-reading-margin.webp", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" } },
    { "route": "/assets/social.png", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" } },
    { "route": "/assets/index-*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } }
  ]
}
